{
  "expo": {
    "name": "MamaCare",
    "slug": "mamacare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.team.mamacare"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE4EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.team.mamacare",
      "backgroundColor": "#FFF7F9"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MamaCare to pick a photo of your prescription or lab report.",
          "cameraPermission": "Allow MamaCare to take a photo of your prescription or lab report.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "scheme": "mamacare",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d751eb71-9596-47e5-968b-c8c81cb0f1b4"
      }
    },
    "owner": "waqas_11"
  }
}
