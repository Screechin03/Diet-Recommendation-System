# Copy to .env for local dev. For cloud (EAS) builds, set the same keys with `eas env:create`.

# The deployed Next.js web app (NOT the Render FastAPI URL): the app calls its /api/* routes.
EXPO_PUBLIC_API_URL=https://your-app.vercel.app

# Same Supabase project as the website (Project Settings -> API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
